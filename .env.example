# Copy to .env and edit. .env is git-ignored. Never commit real secrets.

# --- Database (docker compose + backend) ---
POSTGRES_DB=investin
POSTGRES_USER=investin
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Backend (read from the environment; export them or use `scripts/dev-backend.sh`) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/investin
DATABASE_USER=investin
DATABASE_PASSWORD=change-me-locally
SPRING_PROFILES_ACTIVE=dev        # 'dev' loads FICTIONAL demo data. Do not use in production.
STORAGE_TYPE=local               # local | s3
STORAGE_DIR=./data/uploads        # local files; also the resize cache for s3
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO...). Keep the bucket PRIVATE; images are served via /api/v1/media.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                      # empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true
SESSION_COOKIE_SECURE=false       # set true behind HTTPS
FORWARD_HEADERS_STRATEGY=none     # set 'native' behind a reverse proxy so rate limiting sees client IPs
# First administrator (only used while no admin exists; min. 12 chars; remove after first start):
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
STALE_AFTER_DAYS=60
# Inquiry e-mail notification to staff (optional; both MAIL_HOST and INQUIRY_NOTIFY_TO must be set):
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@investin.az
INQUIRY_NOTIFY_TO=              # comma-separated staff addresses

# --- Frontend (Next.js reads these from frontend/.env.local or the real environment, NOT from this root file) ---
BACKEND_URL=http://localhost:8080 # server-side proxy target for /api/*
# MapLibre style JSON. Default is OpenFreeMap (no key; attribution is shown by the map). See README for alternatives.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# CSP_MAP_ORIGINS=https://tiles.example.com   # extra space-separated origins if your map provider serves tiles/glyphs from other hosts (runtime)
# NEXT_PUBLIC_MAP_FONT=Noto Sans Bold   # glyph font name used for marker labels; must exist in the style's glyph set
